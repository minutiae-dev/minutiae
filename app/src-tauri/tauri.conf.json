{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minutiae",
  "version": "0.1.0",
  "identifier": "com.minutiae.app",
  "build": {
    "beforeDevCommand": "bash ../scripts/build-sidecar.sh && pnpm dev",
    "beforeBuildCommand": "bash ../scripts/build-sidecar.sh release && pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Minutiae",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["minutiae"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/minutiae-engine"],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "entitlements": "./Entitlements.plist"
    }
  }
}
