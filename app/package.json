{
  "name": "minutiae",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:saas": "VITE_SAAS=1 playwright test",
    "dev:ui-fixtures": "vite --mode ui-fixtures",
    "build:native-test": "tauri build --debug --features native-test --config src-tauri/tauri.native-test.conf.json --no-bundle",
    "test:native": "wdio run wdio.conf.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.20.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "dompurify": "^3.4.11",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "@wdio/cli": "9",
    "@wdio/local-runner": "9",
    "@wdio/mocha-framework": "9",
    "@wdio/spec-reporter": "9",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "^5",
    "vite": "^6"
  }
}
